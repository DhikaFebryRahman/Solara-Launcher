<Window x:Class="MinecraftLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Solara Launcher" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource StitchBackground}"
        Foreground="{StaticResource StitchTextPrimary}"
        FontFamily="Inter, Segoe UI, sans-serif">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource StitchSurface}" BorderBrush="{StaticResource StitchBorder}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,32,0,0">
                <TextBlock Text="MINECRAFT" FontWeight="Bold" FontSize="20" Margin="24,0,0,32" Foreground="{StaticResource StitchPrimary}"/>
                
                <ListBox x:Name="SidebarMenu" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="SidebarMenu_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="24,12"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Foreground" Value="{StaticResource StitchTextSecondary}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StitchPrimary}"/>
                                    <Setter Property="Background" Value="#1A7C5CFC"/> <!-- Semi transparent primary -->
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource StitchSurfaceOverlay}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="GamepadVariant" Width="20" Height="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Play" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderDownload" Width="20" Height="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Installations" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TshirtCrew" Width="20" Height="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Skins" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Margin="0,0,12,0"/>
                            <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="32">
            <!-- PLAY VIEW -->
            <Grid x:Name="PlayView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Dashboard - Play" FontSize="32" FontWeight="Bold" Margin="0,0,0,24"/>
                
                <!-- Main Card -->
                <Border Grid.Row="1" Background="{StaticResource StitchSurface}" CornerRadius="16" BorderBrush="{StaticResource StitchBorder}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                        <TextBlock Text="PLAYER CONFIGURATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource StitchTextSecondary}" Margin="0,0,0,16"/>
                        
                        <TextBox x:Name="TxtPlayerName" materialDesign:HintAssist.Hint="Player Name" Margin="0,0,0,16" Foreground="White" BorderBrush="{StaticResource StitchBorder}"/>
                        
                        <TextBox x:Name="TxtVersion" materialDesign:HintAssist.Hint="Version (e.g. 1.20.1)" Margin="0,0,0,32" Foreground="White" BorderBrush="{StaticResource StitchBorder}"/>
                        
                        <Button x:Name="BtnLaunch" Content="PLAY" Height="56" FontSize="18" FontWeight="Bold" Background="{StaticResource StitchPrimary}" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="8" Click="BtnLaunch_Click"/>
                    </StackPanel>
                </Border>

                <!-- Status Panel -->
                <Border Grid.Row="2" Margin="0,24,0,0" Background="{StaticResource StitchSurfaceOverlay}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="LblStatus" Text="Ready" Foreground="{StaticResource StitchTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="ProgressBarStatus" IsIndeterminate="True" Visibility="Collapsed" Height="4" Foreground="{StaticResource StitchPrimary}" Background="{StaticResource StitchBorder}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- INSTALLATIONS VIEW -->
            <Grid x:Name="InstallationsView" Visibility="Collapsed">
                <TextBlock Text="Installations" FontSize="32" FontWeight="Bold" Margin="0,0,0,24"/>
                <TextBlock Text="Fitur instalasi khusus belum tersedia di pratinjau ini." FontSize="16" Foreground="{StaticResource StitchTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- SKINS VIEW -->
            <Grid x:Name="SkinsView" Visibility="Collapsed">
                <TextBlock Text="Skins" FontSize="32" FontWeight="Bold" Margin="0,0,0,24"/>
                <TextBlock Text="Fitur kustomisasi skin belum tersedia di pratinjau ini." FontSize="16" Foreground="{StaticResource StitchTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- SETTINGS VIEW -->
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Settings" FontSize="32" FontWeight="Bold" Margin="0,0,0,24"/>
                
                <StackPanel Grid.Row="1" Width="400" HorizontalAlignment="Left">
                    <TextBlock Text="SYSTEM CONFIGURATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource StitchTextSecondary}" Margin="0,0,0,16"/>
                    <TextBox x:Name="TxtRamMb" materialDesign:HintAssist.Hint="Allocated RAM (MB)" Margin="0,0,0,16" Foreground="White" BorderBrush="{StaticResource StitchBorder}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
